# Copy this file to .env and adjust values as needed

# Set to true to use local mock data (no backend required)
# Set to false to connect to the real backend at localhost:8080
VITE_MOCK_MODE=true

# Backend API base URL (leave unset to default to http://localhost:8080/api)
# VITE_API_URL=http://localhost:8080/api

# WebSocket host for AI recommendation push notifications
# Points to the aiservice directly (or via nginx proxy in Docker)
VITE_WS_HOST=http://localhost:8083

# Production override (Render deployment)
# VITE_API_URL=https://fitness-gateway.onrender.com/api
# VITE_WS_HOST=https://fitness-aiservice.onrender.com
