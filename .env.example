# =============================================================================
# FITNESS APP — Environment Variables
# Copy this file to .env for local dev. NEVER commit .env to version control.
# For Render: set all sync:false vars in the Render dashboard during Blueprint setup.
# =============================================================================

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
# Used by: Gateway, UserService, ActivityService
JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars

# ─── Gemini AI ────────────────────────────────────────────────────────────────
# API key from: https://aistudio.google.com
# Used by: AIService
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Render deployment: auto-wired from fitness-postgres database (no manual input needed)
# Local dev: use docker-compose which spins up a local postgres container
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fitness_user_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=admin@123

# ─── Redis ────────────────────────────────────────────────────────────────────
# Render deployment: auto-wired from fitness-redis service (no manual input needed)
# Local dev: use docker-compose which spins up a local redis container
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── MongoDB (MongoDB Atlas) ──────────────────────────────────────────────────
# Free tier: https://www.mongodb.com/atlas
# Create cluster → Connect → Drivers → copy URI, replace <password>
# ActivityService DB  → fitnessactivity
# AIService DB        → fitnessrecommendation
# Used by: ActivityService
SPRING_DATA_MONGODB_URI_ACTIVITY=mongodb+srv://fitness-admin:<password>@fitness-cluster.xxxxx.mongodb.net/fitnessactivity?retryWrites=true&w=majority
# Used by: AIService
SPRING_DATA_MONGODB_URI_AI=mongodb+srv://fitness-admin:<password>@fitness-cluster.xxxxx.mongodb.net/fitnessrecommendation?retryWrites=true&w=majority
# Note: In Render, both services use the key SPRING_DATA_MONGODB_URI — set separately per service

# ─── Kafka (Aiven) ────────────────────────────────────────────────────────────
# Create Kafka service on Aiven → Connection Info → copy bootstrap URI
# Used by: ActivityService, AIService
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka-xxxxx.aivencloud.com:PORT

# Auth method: SASL (select SASL on Aiven when creating service)
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=SCRAM-SHA-256

# Build JAAS config from Aiven SASL credentials:
# username = avnadmin (default), password = from Aiven dashboard → Connection Info
KAFKA_SASL_JAAS_CONFIG=org.apache.kafka.common.security.scram.ScramLoginModule required username="avnadmin" password="<your-aiven-kafka-password>";

# Leave as-is (required for Aiven hostname verification)
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=https

# ─── Kafka Topics (create these on Aiven dashboard) ──────────────────────────
# activity-updates    (used by ActivityService → AIService)
