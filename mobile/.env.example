# Copy this to .env — never commit real secrets

# Backend gateway URL (used by the mobile app for all API calls)
EXPO_PUBLIC_API_URL=https://your-gateway.onrender.com/api

# Set to false to connect to real backend, true to use mock data
EXPO_PUBLIC_MOCK_MODE=false

# Local development override (point to gateway running via Docker Compose)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api  (Android emulator)
# EXPO_PUBLIC_API_URL=http://localhost:8080/api  (iOS simulator / Expo Go)
