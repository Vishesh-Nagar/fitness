<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- Inherit Spring Boot defaults (plugin management, dependency versions) -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.4.3</version>
		<relativePath/>
	</parent>

	<groupId>com.fitness</groupId>
	<artifactId>fitness-parent</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>fitness-parent</name>
	<description>Parent POM for all Fitness microservices</description>

	<properties>
		<java.version>21</java.version>
		<spring-cloud.version>2024.0.0</spring-cloud.version>
		<!-- Override Spring Boot's Lombok 1.18.32 — required for Java 25 support -->
		<lombok.version>1.18.40</lombok.version>
	</properties>

	<modules>
		<module>common-lib</module>
		<module>configserver</module>
		<module>eureka</module>
		<module>gateway</module>
		<module>userservice</module>
		<module>activityservice</module>
		<module>aiservice</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<!-- Spring Cloud BOM — manages versions for all Spring Cloud starters -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<!-- Internal common-lib — shared DTOs, events, error shapes -->
			<dependency>
				<groupId>com.fitness</groupId>
				<artifactId>common-lib</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>



</project>

