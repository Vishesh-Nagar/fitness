# Copy this file to .env — NEVER commit .env to version control
# Generate JWT secret with: openssl rand -hex 32

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Must be at least 32 chars for HS256
JWT_SECRET_KEY=change-me-to-a-long-random-secret-min-32-chars

# ─── Gemini AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent

# ─── PostgreSQL (User Service) ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# ─── Redis (Rate Limiting + JWT Blocklist) ────────────────────────────────────
REDIS_HOST=fitness-redis      # use localhost when running outside Docker
REDIS_PORT=6379

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Internal Service Auth ────────────────────────────────────────────────────
# Used by ActivityService to validate users against UserService
INTERNAL_SERVICE_SECRET=change-me-to-another-random-secret

# ─── Aiven Cloud (optional — for production Render deployment) ────────────────
# SPRING_DATA_MONGODB_URI=mongodb+srv://...@...aiven.com/fitnessdb?tls=true
# SPRING_DATASOURCE_URL=jdbc:postgresql://...aiven.com:PORT/defaultdb?ssl=require
# KAFKA_BOOTSTRAP_SERVERS=...aiven.com:PORT
# KAFKA_SECURITY_PROTOCOL=SSL
# KAFKA_SSL_TRUSTSTORE_TYPE=PEM
# KAFKA_SSL_CA_CERT=<base64-encoded-CA-cert>
